  "patterns": [
    {
      "id": "render_err_unsupported",
      "pattern": "^이 브라우저에서는 전체화면 미리보기를 지원하지 않습니다\\.$",
      "template": "$0"
    },
    {
      "id": "render_error_audio",
      "pattern": "^오디오 재생 실패: (.+)$",
      "template": "$0"
    },
    {
      "id": "render_error_webm",
      "pattern": "^WebM 녹화 실패: (.+)$",
      "template": "$0"
    },
    {
      "id": "render_error_background",
      "pattern": "^영상 배경 적용 실패: (.+)$",
      "template": "$0"
    },
    {
      "id": "render_error_short",
      "pattern": "^MP4 출력 실패: (.+)$",
      "template": "$0"
    },
    {
      "id": "webm_temp_fail",
      "pattern": "^WebM 임시 저장 실패(.*): (.+)\\. 디스크 여유 공간을 확인한 뒤 다시 시도하세요\\.$",
      "template": "$0"
    },
    {
      "id": "encoder_probe_fail",
      "pattern": "^인코더 확인 실패: (.+)$",
      "template": "$0"
    },
    {
      "id": "fast_engine_fail",
      "pattern": "^고속 엔진 모듈 로딩 실패(.*): (.+)$",
      "template": "$0"
    },
    {
      "id": "rec_download",
      "pattern": "^오디오 포함 WebM 다운로드 요청 · (.+)초 · 화면 갱신 (.+)회 · 건너뜀 (.+)회 · 화면 지연 (.+)회 · 탭 비활성 (.+)초 · (.+) 임시 저장 \\(실제 인코딩 프레임 수는 다를 수 있음\\)$",
      "template": "$0"
    },
    {
      "id": "rec_remaining",
      "pattern": "^남은 시간 약 (.+)초$",
      "template": "$0"
    },
    {
      "id": "rec_delay",
      "pattern": "^ · 화면 지연 (.+)회$",
      "template": "$0"
    },
    {
      "id": "rec_progress",
      "pattern": "^녹화 중 (.+) / (.+) · 화면 갱신 (.+)회 · 건너뜀 (.+)회(.*)$",
      "template": "$0"
    },
    {
      "id": "render_fast_fail",
      "pattern": "^고속 MP4 출력 실패: (.+) · 호환 렌더링을 선택해 다시 시도할 수 있습니다\\.$",
      "template": "$0"
    },
    {
      "id": "score_percent",
      "pattern": "^악보/MIDI 음표 매칭 (.+)%$",
      "template": "$0"
    },
    {
      "id": "render_repeat_expanded",
      "pattern": "^ · 되돌이표 전개 (.+)→(.+)마디$",
      "template": "$0"
    },
    {
      "id": "render_automatic_point",
      "pattern": "^자동 제안 · (.+)$",
      "template": "$0"
    },
    {
      "id": "render_camera_point",
      "pattern": "^(.+)마디 (.+) · (.+)$",
      "template": "$0"
    },
    {
      "id": "render_prev_fps",
      "pattern": "^\\(이전 출력 평균 (.+)프레임/초 기준\\)$",
      "template": "$0"
    },
    {
      "id": "render_eta_compat",
      "pattern": "^예상 시간: (.+) · 기존 Chromium \\+ FFmpeg 경로$",
      "template": "$0"
    },
    {
      "id": "export_duration",
      "pattern": "^(.+) 분량을 실제 재생 없이 프레임별로 생성합니다\\. 출력 시간은 컴퓨터 성능에 따라 달라집니다\\.$",
      "template": "$0"
    },
    {
      "id": "export_plan",
      "pattern": "^출력 예정: (.+) · (.+)×(.+) · (.+)fps · (.+)$",
      "template": "$0"
    },
    {
      "id": "start_export",
      "pattern": "^(.+) MP4 시작$",
      "template": "$0"
    },
    {
      "id": "export_untested",
      "pattern": "^(.+)×(.+) · (.+)fps(.*) 전체 곡은 미검증입니다\\. 실패하거나 메모리가 부족하면 호환 렌더링을 선택하세요\\.$",
      "template": "$0"
    },
    {
      "id": "phase_delay",
      "pattern": "^([+-]?\\d+(?:\\.\\d+)?)초 먼저$",
      "template": "$0"
    },
